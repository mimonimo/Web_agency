# 비밀·토큰은 절대 커밋하지 않는다 (BRIEF §15-6)
.env
provisioning/out/

# 사이클 실행 산출물 — 재생성 가능하고 reset 으로 날아간다 (BRIEF §3.5)
repo/runs/

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/

# 오프라인 반출용 이미지 아카이브 (수 GB)
ops/images/*.tar

# 네이티브 실행 산출물 — 재생성 가능
.hq.pid
repo/agora.db
repo/agora.db-*
repo/hq.log
repo/project-001/
ops/wheels/*.whl
repo/.archive/
repo/boot.log

# 실제 노드 IP — 공개 리포에 올리지 않는다 (students.yaml 은 예시 값)
provisioning/students.local.yaml
