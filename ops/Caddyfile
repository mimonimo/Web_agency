# AGORA HQ 리버스 프록시 / 정적 서빙
# 인터넷이 없으므로 자동 HTTPS 를 끈다. 교실 L2 안에서 평문 HTTP 로만 돈다.

{
	auto_https off
	admin off
}

:80 {
	# API 는 core(FastAPI) 로
	handle /api/* {
		reverse_proxy core:8000
	}

	# OpenAPI 문서 — 학생·강사가 엔드포인트를 눈으로 확인하는 용도
	handle /docs* {
		reverse_proxy core:8000
	}
	handle /openapi.json {
		reverse_proxy core:8000
	}

	# 나머지는 정적 파일. 빌드 스텝 없음, CDN 없음 (BRIEF §8)
	handle {
		root * /srv/web
		try_files {path} {path}/ /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
