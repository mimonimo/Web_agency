# AGORA HQ 환경변수 — `make up` 이 .env 가 없으면 이 파일을 복사한다.
# 실제 .env 는 커밋하지 않는다 (BRIEF §15-6).

# ── HQ 자신 ────────────────────────────────────────────────────────
HQ_HOST=220.67.5.62
HQ_IP=220.67.5.62
HQ_HTTP_PORT=80
CORE_PORT=8000

# ── Postgres ──────────────────────────────────────────────────────
POSTGRES_USER=agora
POSTGRES_PASSWORD=change-me-in-dotenv
POSTGRES_DB=agora
POSTGRES_PORT=5432
DATABASE_URL=sqlite+pysqlite:///./repo/agora.db

# ── 노드 인증 ──────────────────────────────────────────────────────
# 노드가 HQ 에 붙을 때 쓰는 공유 비밀. provision.py 가 노드별 토큰을 파생시킨다.
# 인수 #10(잘못된 토큰 → 401)의 근거값.
NODE_TOKEN_SECRET=change-me-in-dotenv

# ── 프로젝트 ───────────────────────────────────────────────────────
PROJECT_ID=project-001
DEFAULT_PIPELINE=web_delivery

# ── 타임아웃 (BRIEF §15-3: 로컬 모델은 느리다) ────────────────────
DEFAULT_STEP_TIMEOUT_SEC=900
A2A_POLL_INTERVAL_SEC=5
NODE_HEARTBEAT_TIMEOUT_SEC=90
SPEC_POLL_INTERVAL_SEC=3

# ── 로케일 ─────────────────────────────────────────────────────────
TZ=Asia/Seoul

# ── 실행 백엔드 ────────────────────────────────────────────────────
# sim  — HQ 안에서 산출물을 흉내낸다. 흐름·화면 확인, 리허설용
# a2a  — 실제 학생 노드의 Hermes 를 호출한다 (Phase 2 이후)
EXECUTOR=sim
# sim 한 단계에 걸리는 시간(초). 프로젝터로 볼 때는 4~6초가 보기 좋다.
SIM_STEP_SEC=4

# 정적 파일을 core 가 직접 서빙할지 (네이티브 실행 시 1, caddy 쓸 때 0)
SERVE_WEB=1
# 1 이면 토큰 없는 요청도 401. 수업 첫날엔 0 으로 두는 편이 안전하다.
REQUIRE_NODE_TOKEN=0
